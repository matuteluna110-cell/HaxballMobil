// ===== UI PERSONALIZADA =====

(function(){

const ui = document.createElement("div");

ui.id = "customUI";

ui.style = `
position:fixed;
right:15px;
bottom:20px;
z-index:99999;
font-family:Arial;
`;


function crearBoton(texto, funcion){

let b=document.createElement("button");

b.innerHTML=texto;

b.style=`
display:block!important;
width:60px;
height:60px;
margin:8px;
border-radius:50%;
background:#800020;
color:white;
border:2px solid #b03060;
font-size:22px;
box-shadow:0 0 10px #800020;
`;

b.onclick=funcion;

ui.appendChild(b);

}


// Botón menú

crearBoton("☰",()=>{

alert("Menú abierto");

});


// Botón disparo

crearBoton("⚽",()=>{

console.log("Disparo");

});


// Botón mensajes

crearBoton("💬",()=>{

console.log("Mensajes");

});


document.body.appendChild(ui);


})();



// ===== CONTROLES TÁCTILES DVIDI =====

(function(){

const controles = document.createElement("div");

controles.style = `
position:fixed;
left:20px;
bottom:20px;
z-index:99999;
`;


function boton(tecla, x, y){

let b=document.createElement("button");

b.innerHTML=tecla;

b.style=`
position:fixed;
${x};
${y};
width:60px;
height:60px;
border-radius:50%;
background:#800020;
color:white;
border:2px solid #b03060;
font-size:20px;
`;

b.onpointerdown=()=>{
document.dispatchEvent(new KeyboardEvent("keydown",{
key:tecla,
code:"Key"+tecla.toUpperCase(),
bubbles:true
}));
};

b.onpointerup=()=>{
document.dispatchEvent(new KeyboardEvent("keyup",{
key:tecla,
code:"Key"+tecla.toUpperCase(),
bubbles:true
}));
};

document.body.appendChild(b);

}


// Movimiento

boton("W","80px","calc(100% - 160px)");
boton("A","20px","calc(100% - 100px)");
boton("S","80px","calc(100% - 100px)");
boton("D","140px","calc(100% - 100px)");


// Acciones

boton(" ","calc(100% - 130px)","calc(100% - 100px)"); // Espacio
boton("X","calc(100% - 70px)","calc(100% - 160px)");


})();
