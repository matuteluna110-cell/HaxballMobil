// ===== UI PERSONALIZADA =====

(function(){

const ui = document.createElement("div");

ui.id = "customUI";

ui.style = `
position:fixed;
right:15px;
bottom:20px;
z-index:99999;
font-family:Arial;
`;


function crearBoton(texto, funcion){

let b=document.createElement("button");

b.innerHTML=texto;

b.style=`
display:block!important;
width:60px;
height:60px;
margin:8px;
border-radius:50%;
background:#800020;
color:white;
border:2px solid #b03060;
font-size:22px;
box-shadow:0 0 10px #800020;
`;

b.onclick=funcion;

ui.appendChild(b);

}


// Botón menú

crearBoton("☰",()=>{

alert("Menú abierto");

});


// Botón disparo

crearBoton("⚽",()=>{

console.log("Disparo");

});


// Botón mensajes

crearBoton("💬",()=>{

console.log("Mensajes");

});


document.body.appendChild(ui);


})();
